# macOS
.DS_Store

# Source texts. DRM-free EPUBs live here and are never committed.
pipeline/sources/

# The fixture EPUB is generated by tests/fixtures/fixture_book.py, not stored.
pipeline/tests/fixtures/*.epub

# Anki exports and the known-lemma seed built from them. Personal vocabulary,
# and regenerable from the deck at any time.
*.anki.txt
known.json

# Downloaded Wiktionary extracts and the shared gloss cache. Derived data: a
# rebuild reproduces all of it, and the extracts alone are over a gigabyte.
pipeline/cache/

# Generated bundles and reports, except the committed test fixture — the app
# needs one small, stable bundle to develop its import path against in Phase 3.
bundles/*
!bundles/.gitkeep
!bundles/anonimo-los-del-cerro.molcajete.json
!bundles/anonimo-los-del-cerro.report.txt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node (Phase 3 onwards)
node_modules/
dist/
dev-dist/
